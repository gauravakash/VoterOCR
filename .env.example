# LLM Provider Selection
LLM_PROVIDER=gemini                      # gemini | claude | gpt4 | sarvam
VISION_MODEL=gemini-2.5-pro              # Vision model for OCR
TEXT_MODEL=gemini-2.5-flash              # Text model for classification

# API Keys (set the one matching LLM_PROVIDER)
GOOGLE_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=voter-ocr

# Sarvam-specific (used only when LLM_PROVIDER=sarvam)
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LANGUAGE=hi-IN
SARVAM_OUTPUT_FORMAT=md
SARVAM_PAGES_PER_CHUNK=10

# Pipeline
MAX_CONCURRENT_PDFS=3
MAX_CONCURRENT_PAGES_PER_PDF=5
MAX_CONCURRENT_CHUNKS_PER_PDF=3          # Sarvam path only
DPI=200

# Paths
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
DB_PATH=./data/jobs.db
PORT=8000

# Costs / limits
COST_PER_PAGE_INR=0.50
MAX_UPLOAD_SIZE_MB=50
